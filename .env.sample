# General Application Settings

NODE_ENV=development # The environment the application is running in (e.g., development, production, test)

# Backend Server Settings

SERVER_PORT=3001 # The port on which the Node.js Express API server will listen

# Database Settings (SQLite)

DB_FILE_PATH=./data/database.sqlite # Path to the SQLite database file

# Frontend Application Settings (React)

REACT_APP_API_BASE_URL=http://localhost:3001/api # The base URL for the backend API that the React frontend will consume